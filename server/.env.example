# Rename this file to .env and replace the connection string
# Example for local development using Docker postgres service
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barberdb?schema=public"

# Firebase admin credentials
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@example.iam.gserviceaccount.com"
# Paste private key with escaped \n newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
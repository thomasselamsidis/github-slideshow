// Prisma schema for Barber Booking App

// Data source: use PostgreSQL; DATABASE_URL defined in env

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELED
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  phone    String?
  role     UserRole @default(CLIENT)
  isMember Boolean  @default(false)
  points   Int      @default(0)

  // Relations
  appointments Appointment[]       @relation("ClientAppointments")
  cutsGiven    Appointment[]       @relation("BarberAppointments")
  membership   Membership?
  rewardTx     RewardTransaction[]

  createdAt DateTime @default(now())
}

model Appointment {
  id String @id @default(cuid())

  client   User   @relation("ClientAppointments", fields: [clientId], references: [id])
  clientId String

  barber   User   @relation("BarberAppointments", fields: [barberId], references: [id])
  barberId String

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  dateTime DateTime
  status   AppointmentStatus @default(UPCOMING)

  rewardTx RewardTransaction?

  createdAt DateTime @default(now())
}

model Service {
  id       String  @id @default(cuid())
  title    String
  duration Int // minutes
  price    Int // cents
  active   Boolean @default(true)

  appointments Appointment[]
}

model Membership {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique
  activeSince DateTime @default(now())
  expiresAt   DateTime
  plan        String
}

model RewardTransaction {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  appointmentId String?      @unique
  pointsAwarded Int
  createdAt     DateTime     @default(now())
}
